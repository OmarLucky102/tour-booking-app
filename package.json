    "eslint": "^9.39.2",
    "eslint-config-airbnb": "^5.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "ndb": "^0.2.4",
    "parcel": "^2.16.3",
    "prettier": "^3.6.2"
  }
