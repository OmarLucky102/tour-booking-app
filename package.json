{
  "name": "tour-booking-app",
  "version": "1.0.0",
  "description": "learn node, express and mangoDB",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch public/js/index.js --dist-dir public/js/dist",
    "build:js": "parcel build public/js/index.js --dist-dir public/js/dist",
    "build": "npm run build:js"
  },
  "author": "Omar AbdElaty",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "mongoose": "^8.16.5",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "nodemon": "^3.1.10",
    "pug": "^3.0.3",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "validator": "^13.15.15",
    "xss-clean": "^0.1.4"
